# Virtual env
.venv/
venv/

# Output transcripts (POPIA — never commit recorded content)
sessions/*
!sessions/.gitkeep

# Audio captures (if --keep-audio used)
*.wav
*.flac
*.mp3
*.m4a

# Debug audio dumps
debug_audio_*.wav

# Cached models (large; let users download on first run)
models/
~/.cache/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store
*.lnk

# Build artifacts (PyInstaller output + logs; large, regenerated by build-app.ps1).
# Anchored to the repo root so landing/build/ (the landing-page build scripts) is kept.
/build/
/dist/
*.log
*.zip
Volksmond-Setup-*.exe

# The deployable marketing site is generated by landing/build/site_build.py and lives in
# its own repo (DigiPhyte-co/volksmond-site). Track the generator + design source here,
# not the generated output.
/site/

# Generated review artifact from landing/build/validate.py (regenerated on each run)
landing/build/readable.html

# Local agent / tooling state (but DO track shared project skills, e.g. release-volksmond)
.claude/*
!.claude/skills/
.codex-review*.txt
.codex-reviews/
codex-review-*.md

# Internal session docs (untracked from the public repo 2026-07-11; kept on disk,
# and deliberately left in git history - no history rewrite)
HANDOFF-*.md
LAPTOP-FIX-*.md
CLAUDE-LONG-SESSION-IMPROVEMENTS.md
docs/code-review-*.md

# Cloudflare wrangler local cache/state (Pages deploys)
.wrangler/

# Local dev launcher (bare CLI; not part of the shipped app)
transcribe-cli.bat

# AEC test recordings + spike scripts (POPIA: contains real voice audio; local-only)
AEC Recordings/
