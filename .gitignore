# Virtual env
.venv/
venv/

# Output transcripts (POPIA — never commit recorded content)
sessions/*
!sessions/.gitkeep

# Audio captures (if --keep-audio used)
*.wav
*.flac
*.mp3
*.m4a

# Debug audio dumps
debug_audio_*.wav

# Root-level media (screen recordings, demo videos, photos land here from OneDrive;
# POPIA risk if staged). Root-scoped so brand/ images stay tracked.
/*.mp4
/*.mov
/*.mkv
/*.jpg
/*.jpeg
/*.png
/*.gif

# Cached models (large; let users download on first run)
models/
~/.cache/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store
*.lnk

# Build artifacts (PyInstaller output + logs; large, regenerated by build-app.ps1).
/build/
/dist/
*.log
*.zip
Volksmond-Setup-*.exe
# CI-built macOS release artifacts (large; published via release.ps1 -MacDmg, never committed)
Volksmond-*.dmg
# The real Partner Center identity values (public repo; only identity.sample.json is committed),
# and any locally packed Store package (large; built by msix\build-msix.ps1 outside the repo).
msix/identity.json
*.msix

# The marketing site lives in its own repo (DigiPhyte-co/volksmond-site); nothing
# site-related is tracked here.
/site/

# Local agent / tooling state (incl. skills; they sync between machines via OneDrive)
.claude/
.codex-review*.txt
.codex-reviews/
codex-review-*.md

# Internal docs are PRIVATE (decision 2026-07-15: plans/briefs/session docs stay out
# of the public repo; history scrubbed the same day). They live on disk in the
# OneDrive-synced cockpit. docs/ is default-private; public docs are opt-in below.
docs/*
!docs/volksmond-quick-start.html
!docs/volksmond-quick-start-af.html
/IMPROVEMENTS.md
/RELEASE.md
/STATE.md
/CLAUDE.md
/landing/
/design/
/Volksmond - Landing Page.html
HANDOFF-*.md
LAPTOP-FIX-*.md
CLAUDE-LONG-SESSION-IMPROVEMENTS.md

# Cloudflare wrangler local cache/state (Pages deploys)
.wrangler/

# Local dev launcher (bare CLI; not part of the shipped app)
transcribe-cli.bat

# AEC test recordings + spike scripts (POPIA: contains real voice audio; local-only)
AEC Recordings/
